    "astro": "^6.4.5",
    "rehype-katex": "^7.0.1",
    "remark-math": "^6.0.0",
    "satori": "^0.25.0",
    "satori-html": "^0.3.2",
    "sharp": "^0.34.3"
  },
  "devDependencies": {
    "@pagefind/default-ui": "^1.5.0",
