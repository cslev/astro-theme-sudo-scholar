  "type": "module",
  "version": "0.1.0",
  "license": "MIT",
  "author": "Levente Csikor",
  "homepage": "https://cslev.github.io/astro-theme-sudo-scholar/",
  "repository": {
    "type": "git",
    "url": "https://github.com/cslev/astro-theme-sudo-scholar"
  },
  "keywords": [
    "astro",
    "astro-template",
    "astro-theme",
    "cv",
    "resume",
    "portfolio",
    "academic",
    "publications",
    "blog"
