# The rendered CV lives here as a plain static file so /cv/index.php can
# read it straight off disk. It must never be reachable by a direct browser
# request — only PHP's own filesystem access (which this rule does not
# affect) is allowed to read it.

# Apache 2.4+
<IfModule mod_authz_core.c>
    Require all denied
</IfModule>

# Apache 2.2 fallback
<IfModule !mod_authz_core.c>
    Order deny,allow
    Deny from all
</IfModule>
