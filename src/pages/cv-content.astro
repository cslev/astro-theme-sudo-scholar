---
import BaseHead from '../components/BaseHead.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import Timeline from '../components/Timeline.astro';
import SkillBars from '../components/SkillBars.astro';
import { SITE_TITLE } from '../consts';
import {
	CV_COURSES,
	CV_EDUCATION,
	CV_FUN_FACTS,
	CV_HOBBIES,
	CV_NOTABLE_MENTIONS,
	CV_SKILL_GROUPS,
	CV_SOFT_SKILLS,
	CV_SUMMARY,
	CV_TEACHING,
	CV_WORK_HISTORY,
} from '../data/cv';
import type { FunFact } from '../data/cv';

// Small stroke-style icon set matching the rest of the CV page's iconography
// (course cards, homepage "About me" cards) — kept here rather than in the
// data file so cv.ts stays plain data.
const FUN_FACT_ICONS: Record<FunFact['icon'], string> = {
	map: '<path d="M20 10c0 6-8 12-8 12s-8-6-8-12a8 8 0 0 1 16 0Z"></path><circle cx="12" cy="10" r="3"></circle>',
	github:
		'<path d="M15 22v-4a4.8 4.8 0 0 0-1-3.5c3 0 6-2 6-5.5.08-1.25-.27-2.48-1-3.5.28-1.15.28-2.35 0-3.5 0 0-1 0-3 1.5-2.64-.5-5.36-.5-8 0C6 2 5 2 5 2c-.3 1.15-.3 2.35 0 3.5A5.403 5.403 0 0 0 4 9c0 3.5 3 5.5 6 5.5-.39.49-.68 1.05-.85 1.65-.17.6-.22 1.23-.15 1.85v4"></path><path d="M9 18c-4.51 2-5-2-7-2"></path>',
	bug: '<path d="M8 2 9.88 3.88"></path><path d="M14.12 3.88 16 2"></path><path d="M9 7.13V6a3 3 0 1 1 6 0v1.13"></path><path d="M12 20c-3.3 0-6-2.7-6-6v-3a4 4 0 0 1 4-4h4a4 4 0 0 1 4 4v3c0 3.3-2.7 6-6 6"></path><path d="M12 20v-9"></path><path d="M6.53 9C4.6 8.8 3 7.1 3 5"></path><path d="M6 13H2"></path><path d="M3 21c0-2.1 1.7-3.9 3.8-4"></path><path d="M20.97 5c0 2.1-1.6 3.8-3.5 4"></path><path d="M22 13h-4"></path><path d="M17.2 17c2.1.1 3.8 1.9 3.8 4"></path>',
	blog: '<path d="M12 20h9"></path><path d="M16.5 3.5a2.121 2.121 0 0 1 3 3L7 19l-4 1 1-4Z"></path>',
};
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={`CV | ${SITE_TITLE}`} description="Curriculum Vitae" />
	</head>
	<body data-pagefind-ignore>
		<Header />
		<main class="cv-page">
			<h1>Curriculum Vitae</h1>
			<p class="cv-summary"><span class="cv-summary-label">Short Bio:</span> {CV_SUMMARY}</p>

			<div class="cv-columns">
				<div class="cv-column">
					<section class="cv-section">
						<h2>Experience</h2>
						<Timeline entries={CV_WORK_HISTORY} />
					</section>

					<section class="cv-section">
						<h2>Education</h2>
						<Timeline entries={CV_EDUCATION} />
					</section>

					<section class="cv-section">
						<h2>Teaching</h2>
						<Timeline entries={CV_TEACHING} />
					</section>

					<section class="cv-section">
						<h2>Notable Mentions</h2>
						<Timeline entries={CV_NOTABLE_MENTIONS} />
					</section>
				</div>

				<div class="cv-column cv-column--secondary">
					<section class="cv-section">
						<SkillBars groups={CV_SKILL_GROUPS} />
					</section>

					<section class="cv-section">
						<h2>Soft Skills</h2>
						<div class="tag-grid">
							{CV_SOFT_SKILLS.map((skill) => (
								<span class="tag-pill">{skill}</span>
							))}
						</div>
					</section>

					<section class="cv-section">
						<h2>Fun Facts</h2>
						<div class="fun-facts-grid">
							{CV_FUN_FACTS.map((fact) => (
								<div class="fun-fact-card">
									<span class="fun-fact-icon" aria-hidden="true" set:html={`<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">${FUN_FACT_ICONS[fact.icon]}</svg>`} />
									<span class="fun-fact-label">{fact.label}</span>
									<span class="fun-fact-value">{fact.value}</span>
								</div>
							))}
						</div>
					</section>

					<section class="cv-section">
						<h2>Hobbies</h2>
						<div class="tag-grid">
							{CV_HOBBIES.map((hobby) => (
								<span class="tag-pill">{hobby}</span>
							))}
						</div>
					</section>
				</div>
			</div>

			<section class="cv-section">
				<h2>Random Courses</h2>
				<div class="course-grid">
					{CV_COURSES.map((course) => (
						course.certificate ? (
							<button
								type="button"
								class="course-card course-card--clickable"
								data-certificate-src={course.certificate.src}
								data-certificate-alt={`${course.title} — certificate`}
							>
								<span class="course-icon" aria-hidden="true">
									<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m15 7 3 3-3 3"></path><path d="M9 17 6 14l3-3"></path><rect x="3" y="4" width="18" height="16" rx="2"></rect></svg>
								</span>
								<div class="course-body">
									<span class="course-title">{course.title}</span>
									<div class="course-meta">
										{course.issuer}
										{course.credentialId && <> &bull; {course.credentialId}</>}
										&bull; {course.year}
									</div>
									<span class="course-proof-hint">View certificate &rarr;</span>
								</div>
							</button>
						) : (
							<div class="course-card">
								<span class="course-icon" aria-hidden="true">
									<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m15 7 3 3-3 3"></path><path d="M9 17 6 14l3-3"></path><rect x="3" y="4" width="18" height="16" rx="2"></rect></svg>
								</span>
								<div class="course-body">
									<span class="course-title">{course.title}</span>
									<div class="course-meta">
										{course.issuer}
										{course.credentialId && <> &bull; {course.credentialId}</>}
										&bull; {course.year}
									</div>
								</div>
							</div>
						)
					))}
				</div>
			</section>
		</main>
		<Footer />

		<div class="lightbox-overlay" id="cv-lightbox-overlay" role="dialog" aria-modal="true" aria-label="Certificate preview">
			<button type="button" class="lightbox-close" id="cv-lightbox-close" aria-label="Close certificate preview">&times;</button>
			<img id="cv-lightbox-image" src="" alt="" />
		</div>

		<style>
			.cv-page {
				max-width: 1100px;
			}
			.cv-summary {
				font-size: 1.1rem;
				line-height: 1.7;
				text-align: justify;
				hyphens: auto;
			}
			.cv-summary-label {
				font-weight: 700;
				color: var(--color-text-main);
			}
			.cv-section {
				margin-top: 2.5rem;
			}
			.cv-columns {
				display: grid;
				/* Asymmetric on purpose: the right column (skills/interests/
				   hobbies) is supporting material, not the main content, so
				   it gets a narrower, more compact treatment than the career
				   timeline on the left. */
				grid-template-columns: minmax(0, 2.4fr) minmax(0, 1fr);
				gap: 3rem;
				align-items: start;
			}
			@media (max-width: 900px) {
				.cv-columns {
					grid-template-columns: 1fr;
				}
			}
			.cv-column .cv-section:first-child {
				margin-top: 0;
			}

			/* Secondary column: smaller type throughout, tighter spacing. */
			.cv-column--secondary {
				font-size: 0.88rem;
			}
			.cv-column--secondary :global(h2) {
				font-size: 1.25rem;
			}
			.cv-column--secondary :global(.skill-subheading) {
				font-size: 0.88rem;
			}
			.cv-column--secondary :global(.skill-row) {
				margin-bottom: 0.7rem;
			}
			.cv-column--secondary :global(.skill-row-label) {
				font-size: 0.82rem;
				margin-bottom: 0.25rem;
			}
			.cv-column--secondary :global(.skill-row-tier) {
				font-size: 0.74rem;
			}
			.cv-column--secondary :global(.skill-groups) {
				gap: 1.5rem;
			}

			/* Tags, not ratings — same pill treatment as the blog post tags,
			   so it's visually clear these aren't measured on the skill-dot
			   scale above. */
			.tag-grid {
				display: flex;
				flex-wrap: wrap;
				gap: 0.5rem;
				margin-top: 1rem;
			}
			.tag-pill {
				display: inline-block;
				font-size: 0.8rem;
				font-weight: 600;
				color: var(--color-accent);
				background: var(--color-bg-offset);
				padding: 0.3rem 0.7rem;
				border-radius: 999px;
				border: 1px solid var(--color-border-strong);
			}

			.course-grid {
				display: grid;
				grid-template-columns: repeat(auto-fit, minmax(320px, 1fr));
				gap: 1.25rem;
				margin-top: 1rem;
			}
			.course-card {
				display: flex;
				align-items: flex-start;
				gap: 1rem;
				width: 100%;
				padding: 1.25rem;
				border: 1px solid var(--color-border-strong);
				border-radius: 12px;
				background-color: var(--color-bg-offset);
				font: inherit;
				text-align: left;
				color: inherit;
			}
			.course-card--clickable {
				cursor: pointer;
				transition:
					box-shadow 0.2s ease,
					border-color 0.2s ease;
			}
			.course-card--clickable:hover,
			.course-card--clickable:focus-visible {
				border-color: var(--color-accent);
				box-shadow: var(--shadow-md);
			}
			.course-proof-hint {
				display: inline-block;
				margin-top: 0.5rem;
				font-size: 0.78rem;
				font-weight: 600;
				color: var(--color-accent);
			}
			.course-icon {
				flex-shrink: 0;
				display: inline-flex;
				align-items: center;
				justify-content: center;
				width: 44px;
				height: 44px;
				border-radius: 50%;
				background-color: var(--color-accent-light);
				color: #1a1a1a;
			}
			[data-theme='dark'] .course-icon {
				/* Brighter than the shared --color-accent-light (used
				   elsewhere for subtler tints) so the black glyph has real
				   contrast against it. */
				background-color: var(--color-accent);
			}
			.course-icon svg {
				width: 22px;
				height: 22px;
			}

			.fun-facts-grid {
				display: grid;
				grid-template-columns: repeat(2, 1fr);
				gap: 0.75rem;
				margin-top: 1rem;
			}
			.fun-fact-card {
				display: flex;
				flex-direction: column;
				align-items: center;
				text-align: center;
				padding: 1rem 0.5rem;
				border: 1px solid var(--color-border-strong);
				border-radius: 12px;
				background-color: var(--color-bg-offset);
			}
			.fun-fact-icon {
				display: inline-flex;
				align-items: center;
				justify-content: center;
				width: 36px;
				height: 36px;
				border-radius: 50%;
				background-color: var(--color-accent-light);
				color: #1a1a1a;
				margin-bottom: 0.6rem;
			}
			[data-theme='dark'] .fun-fact-icon {
				/* Brighter than the shared --color-accent-light (used
				   elsewhere for subtler tints) so the black glyph has real
				   contrast against it. */
				background-color: var(--color-accent);
			}
			.fun-fact-icon svg {
				width: 18px;
				height: 18px;
			}
			.fun-fact-label {
				font-size: 0.78rem;
				font-weight: 700;
				color: var(--color-text-main);
				margin-bottom: 0.35rem;
			}
			.fun-fact-value {
				font-size: 1.5rem;
				font-weight: 700;
				color: var(--color-text-muted);
			}
			.course-body {
				/* Flex items default to a content-based min-width, so a long
				   unbroken credential ID (no spaces to wrap at) would stretch
				   this — and the whole card — wider than the grid column
				   instead of wrapping. */
				min-width: 0;
			}
			.course-title {
				display: block;
				font-weight: 700;
				color: var(--color-text-main);
				margin-bottom: 0.35rem;
			}
			.course-meta {
				font-size: 0.85rem;
				color: var(--color-text-muted);
				overflow-wrap: anywhere;
			}

			.lightbox-overlay {
				position: fixed;
				inset: 0;
				z-index: 1000;
				display: none;
				align-items: center;
				justify-content: center;
				background: rgba(0, 0, 0, 0.85);
				opacity: 0;
				transition: opacity 0.2s ease;
			}
			.lightbox-overlay[data-open='true'] {
				display: flex;
				opacity: 1;
			}
			.lightbox-overlay img {
				width: auto;
				height: auto;
				max-width: 90vw;
				max-height: 85vh;
				border-radius: 8px;
				box-shadow: 0 20px 60px rgba(0, 0, 0, 0.5);
			}
			.lightbox-close {
				position: fixed;
				top: 1.25rem;
				right: 1.5rem;
				width: 2.5rem;
				height: 2.5rem;
				display: flex;
				align-items: center;
				justify-content: center;
				border: none;
				border-radius: 50%;
				background: rgba(255, 255, 255, 0.12);
				color: #fff;
				font-size: 1.5rem;
				line-height: 1;
				cursor: pointer;
				transition: background 0.2s ease;
			}
			.lightbox-close:hover,
			.lightbox-close:focus-visible {
				background: rgba(255, 255, 255, 0.25);
			}

			/*
			 * Print stylesheet: the on-screen timeline (vertical line + dots,
			 * generous spacing) is a screen-only affordance. Printed output
			 * should read like a plain document, not a copy of the webpage.
			 */
			@media print {
				:global(header),
				:global(.site-footer),
				:global(#author-modal) {
					display: none !important;
				}
				.lightbox-overlay,
				.course-proof-hint {
					display: none !important;
				}
				.cv-page {
					max-width: none;
					padding: 0;
				}
				.cv-columns {
					display: block;
				}
				:global(.timeline::before) {
					display: none;
				}
				:global(.timeline-marker) {
					display: none;
				}
				:global(.timeline-pill) {
					border: none;
					padding: 0;
					color: inherit;
				}
				:global(.timeline-entry) {
					padding-left: 0;
					margin-bottom: 0.75rem;
					break-inside: avoid;
				}
				.cv-section {
					margin-top: 1.25rem;
					break-inside: avoid;
				}
				.course-card {
					break-inside: avoid;
				}
				:global(a) {
					color: inherit;
					text-decoration: none;
				}
			}
		</style>

		<script is:inline data-astro-rerun>
			function enableCertificateLightbox() {
				const overlay = document.getElementById('cv-lightbox-overlay');
				const lightboxImage = document.getElementById('cv-lightbox-image');
				const closeButton = document.getElementById('cv-lightbox-close');
				if (!overlay || !lightboxImage || !closeButton) return;

				function openLightbox(src, alt) {
					lightboxImage.src = src;
					lightboxImage.alt = alt || '';
					overlay.dataset.open = 'true';
					document.body.style.overflow = 'hidden';
				}

				function closeLightbox() {
					overlay.dataset.open = 'false';
					lightboxImage.src = '';
					document.body.style.overflow = '';
				}

				const cards = Array.from(document.querySelectorAll('.course-card--clickable'));
				for (const card of cards) {
					if (card.dataset.lightboxReady === 'true') continue;
					card.dataset.lightboxReady = 'true';
					card.addEventListener('click', () => {
						openLightbox(card.dataset.certificateSrc, card.dataset.certificateAlt);
					});
				}

				if (!overlay.dataset.lightboxWired) {
					overlay.dataset.lightboxWired = 'true';
					closeButton.addEventListener('click', closeLightbox);
					overlay.addEventListener('click', (event) => {
						if (event.target === overlay) closeLightbox();
					});
					document.addEventListener('keydown', (event) => {
						if (event.key === 'Escape' && overlay.dataset.open === 'true') closeLightbox();
					});
				}
			}

			enableCertificateLightbox();

			if (!window.__cvCertificateLightboxListener) {
				document.addEventListener('astro:after-swap', enableCertificateLightbox);
				window.__cvCertificateLightboxListener = true;
			}
		</script>
	</body>
</html>
