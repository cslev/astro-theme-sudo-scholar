---
import BaseHead from '../components/BaseHead.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import FormattedDate from '../components/FormattedDate.astro';
import { CONTACT, SITE_TITLE, SITE_DESCRIPTION } from '../consts';
import { Image } from 'astro:assets';
import { getCollection } from 'astro:content';
import bibFileRaw from '../data/publications.bib?raw';
import { url } from '../utils/paths';
import { formatAuthor, parseBibTeX, slugForEntry, sortByDateDesc } from '../utils/bibtex';
import profilePhoto from '../assets/profile-photo.jpg';
import LogoMarquee from '../components/LogoMarquee.astro';

const posts = (await getCollection('blog')).sort(
	(a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()
).slice(0, 3);

const latestNews = (await getCollection('news', (entry) => !entry.data.archived))
	.sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf())
	.slice(0, 5);

const publications = sortByDateDesc(parseBibTeX(bibFileRaw)).slice(0, 3);
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
		<style>
			.hero {
				display: flex;
				align-items: center;
				gap: 4rem;
				padding: 4rem 0;
				margin-bottom: 2rem;
			}
			.hero-content { flex: 3; }
			.hero-image { 
				flex: 2; 
				text-align: center;
                position: relative;
			}
			.hero-image img {
				width: 280px;
				height: 280px;
				object-fit: cover;
				border-radius: 50%;
				border: 6px solid var(--color-bg);
				/* Same south-east cast as the blog cards. */
				box-shadow: 0 0 0 1px var(--color-border), 10px 12px 24px rgba(0, 0, 0, 0.16);
			}
			[data-theme='dark'] .hero-image img {
				/* Blend the ring into the dark background instead of the
				   lighter --color-border, so only the border image and the
				   shadow show, no separate contrasting outline. */
				box-shadow: 0 0 0 1px var(--color-bg), 10px 12px 24px rgba(74, 222, 128, 0.18);
			}
            
            .pub-mini-item {
                margin-bottom: 1.5rem;
                padding-bottom: 1.5rem;
                border-bottom: 1px solid var(--color-border);
            }
            .pub-mini-item:last-child { border-bottom: none; margin-bottom: 0; }
            .pub-title { font-weight: 700; color: var(--color-text-main); display: block; margin-bottom: 0.25rem; font-family: var(--font-serif); font-size: 1.1rem; }
            .pub-meta { font-size: 0.9rem; color: var(--color-text-muted); }

            .recent-post-item {
                display: flex;
                align-items: center;
                gap: 1rem;
                margin-bottom: 1.5rem;
                padding-bottom: 1.5rem;
                border-bottom: 1px dashed var(--color-border);
            }
            .recent-post-item:last-child { border-bottom: none; margin-bottom: 0; padding-bottom: 0; }
            .recent-post-thumb {
                flex: 0 0 20%;
                aspect-ratio: 1 / 1;
                border-radius: 8px;
                overflow: hidden;
                display: block;
            }
            .recent-post-thumb img {
                width: 100%;
                height: 100%;
                object-fit: cover;
            }
            .recent-post-body { flex: 1; min-width: 0; }
            .recent-post-title {
                display: block;
                font-family: var(--font-serif);
                font-size: 0.95rem;
                font-weight: 600;
                color: var(--color-text-main);
                margin-bottom: 0.25rem;
            }

			.hero-buttons {
				display: flex;
				gap: 1rem;
				flex-wrap: wrap;
			}
			#hero-role {
				display: inline-block;
				transition: opacity 0.3s ease;
			}
			.hero-cursor {
				/* A solid block, not a thin bar — the classic terminal
				   "overwrite/insert mode" cursor shape, not a text-caret. */
				display: inline-block;
				width: 0.6em;
				height: 1.3em;
				margin-left: 0.1em;
				background-color: currentColor;
				vertical-align: text-bottom;
				animation: hero-cursor-blink 1s steps(1) infinite;
			}
			@keyframes hero-cursor-blink {
				0%, 49% { opacity: 1; }
				50%, 100% { opacity: 0; }
			}
			.hero-terminal {
				font-family: var(--font-serif);
				/* Normal foreground text — black-ish in light mode, near-white
				   in dark mode — same as regular body text; only the `$`
				   prompt itself gets a fixed terminal green. */
				color: var(--color-text-main);
			}
			.hero-command,
			.hero-output {
				display: block;
			}
			.hero-output {
				margin-top: 0.15em;
			}
			.hero-prompt {
				/* Fixed terminal green rather than the theme's --color-accent
				   — this should always read as a shell prompt, independent of
				   whatever accent color the site's light/dark theme uses. */
				color: #15803d;
				font-weight: 700;
			}
			[data-theme='dark'] .hero-prompt {
				/* Brighter for legibility against a dark background. */
				color: #4ade80;
			}
			@media (max-width: 768px) {
				.hero { flex-direction: column-reverse; text-align: center; padding: 2rem 0; gap: 2rem; }
                .hero-image img { width: 200px; height: 200px; }
                .hero-buttons { justify-content: center; }
			}

            .about-grid {
                display: grid;
                grid-template-columns: repeat(2, 1fr);
                gap: 2.5rem;
                margin-top: 1.5rem;
            }
            .about-card h3 {
                margin-top: 0.75rem;
                margin-bottom: 0.5rem;
            }
            .about-card p {
                margin-bottom: 0;
            }
            .about-icon {
                display: inline-flex;
                align-items: center;
                justify-content: center;
                width: 44px;
                height: 44px;
                border-radius: 50%;
                background-color: var(--color-accent-light);
                color: #1a1a1a;
            }
            [data-theme='dark'] .about-icon {
                /* Brighter than the shared --color-accent-light (used
                   elsewhere for subtler tints) so the black glyph has real
                   contrast against it. */
                background-color: var(--color-accent);
            }
            .about-icon svg {
                width: 22px;
                height: 22px;
            }
            @media (max-width: 768px) {
                .about-grid { grid-template-columns: 1fr; gap: 2rem; }
            }

            .news-timeline {
                list-style: none;
                margin: 1.5rem 0 0;
                padding: 0;
                position: relative;
            }
            .news-timeline::before {
                content: '';
                position: absolute;
                top: 0.4rem;
                bottom: 0.4rem;
                left: 6px;
                width: 2px;
                background: var(--color-border);
            }
            .news-entry {
                position: relative;
                padding-left: 2rem;
                margin-bottom: 2rem;
            }
            .news-entry:last-child {
                margin-bottom: 0;
            }
            .news-marker {
                position: absolute;
                left: 0;
                top: 0.45rem;
                width: 14px;
                height: 14px;
                border-radius: 50%;
                background-color: var(--color-bg);
                border: 2px solid var(--color-accent);
            }
            .news-date {
                font-size: 0.8rem;
                font-weight: 600;
                text-transform: uppercase;
                letter-spacing: 0.05em;
                color: var(--color-accent);
                margin-bottom: 0.25rem;
            }
            .news-title {
                font-family: var(--font-serif);
                font-size: 1.15rem;
                line-height: 1.45;
                margin: 0 0 0.6rem 0;
            }
            .news-title a {
                color: inherit;
                text-decoration: none;
                border-bottom: 2px solid var(--color-accent);
            }
            .news-title a:hover {
                color: var(--color-accent);
            }
            .news-summary {
                font-size: 0.95rem;
                color: var(--color-text-muted);
                margin: 0;
            }
            .news-thumb {
                display: block;
                max-width: 320px;
                width: 100%;
                height: auto;
                margin-top: 0.75rem;
                border-radius: 8px;
                border: 1px solid var(--color-border);
            }
		</style>
	</head>
	<body>
		<Header />
		<main>
			<section class="hero">
				<div class="hero-content">
					<h1 style="margin-bottom: 0.5rem; font-size: clamp(1.4rem, 5.5vw, 2.2rem); white-space: nowrap;">{SITE_TITLE}</h1>
					<h2 class="hero-terminal" style="font-weight: 400; margin-bottom: 1.5rem; font-size: 1.05rem; border-bottom: none; padding-bottom: 0; display: block; margin-top: 0;">
						<span class="hero-command"><span class="hero-prompt" aria-hidden="true">$</span> whoami<span class="hero-cursor" aria-hidden="true"></span></span>
						<span class="hero-output"><span id="hero-role">Researcher</span></span>
					</h2>
					<p style="font-size: 1.1rem; line-height: 1.7; margin-bottom: 2rem;">
						TODO: replace with a short introduction — who you are, what you
						work on, and where. A sentence or two is plenty; this is the
						first thing a visitor reads.
					</p>
					<div class="hero-buttons">
						<a href={url('/cv')} class="btn">View CV</a>
						<a href={`mailto:${CONTACT.emails[0]}`} class="btn btn-outline">Get in Touch</a>
					</div>
				</div>
				<div class="hero-image">
					<Image src={profilePhoto} width={280} height={280} alt={SITE_TITLE} fetchpriority="high" loading="eager" />
				</div>
			</section>

			<script>
				// TODO: replace with your own roles/titles — they rotate below your name.
				const ROLES = ['Researcher', 'Engineer', 'Writer'];
				const roleEl = document.getElementById('hero-role');
				if (roleEl) {
					let i = 0;
					setInterval(() => {
						i = (i + 1) % ROLES.length;
						roleEl.style.opacity = '0';
						setTimeout(() => {
							roleEl.textContent = ROLES[i];
							roleEl.style.opacity = '1';
						}, 300);
					}, 3000);
				}
			</script>

			<hr style="margin: 3rem 0; border-top: 1px solid var(--color-border);" />

			<section class="about-me">
				<h2 style="margin-top: 0;">About me</h2>
				<div class="about-grid">
					<div class="about-card">
						<span class="about-icon" aria-hidden="true">
							<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M22 10 12 5 2 10l10 5 10-5Z"></path><path d="M6 12v5c0 1.5 2.5 3 6 3s6-1.5 6-3v-5"></path><path d="M22 10v6"></path></svg>
						</span>
						<h3>Education</h3>
						<p>
							TODO: replace with your degrees, institutions, and where you
							studied — a sentence or two, links to your school(s) optional.
						</p>
					</div>

					<div class="about-card">
						<span class="about-icon" aria-hidden="true">
							<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M14.7 6.3a1 1 0 0 0 0 1.4l1.6 1.6a1 1 0 0 0 1.4 0l3.77-3.77a6 6 0 0 1-7.94 7.94l-6.91 6.91a2.12 2.12 0 0 1-3-3l6.91-6.91a6 6 0 0 1 7.94-7.94l-3.76 3.76z"></path></svg>
						</span>
						<h3>Engineering</h3>
						<p>
							TODO: replace with what you build outside of your main work —
							link to your <a href={url('/projects')}>side projects</a> if
							relevant.
						</p>
					</div>

					<div class="about-card">
						<span class="about-icon" aria-hidden="true">
							<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M9 2v6l-5.5 9.5A2 2 0 0 0 5.2 21h13.6a2 2 0 0 0 1.7-3.5L15 8V2"></path><path d="M8.5 8h7"></path></svg>
						</span>
						<h3>Research</h3>
						<p>
							TODO: replace with your research focus — what you study, and
							why it matters. This can be as short or as detailed as you like.
						</p>
					</div>

					<div class="about-card">
						<span class="about-icon" aria-hidden="true">
							<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M4 22h14a2 2 0 0 0 2-2V6a2 2 0 0 0-2-2h-6L8 0H4a2 2 0 0 0-2 2v18a2 2 0 0 0 2 2Z"></path><path d="M4 22a2 2 0 0 1-2-2V9a2 2 0 0 1 2-2h2"></path><path d="M18 14h-8"></path><path d="M15 18h-5"></path></svg>
						</span>
						<h3>Blogging</h3>
						<p>
							TODO: replace with a note about what you write about — link to
							your <a href={url('/blog')}>blog posts</a> if relevant.
						</p>
					</div>
				</div>
			</section>

			<hr style="margin: 3rem 0; border-top: 1px solid var(--color-border);" />

			<LogoMarquee />

			<hr style="margin: 3rem 0; border-top: 1px solid var(--color-border);" />

			<section class="news-timeline-section">
				<h2 style="margin-top: 0;">Latest News</h2>
				<ol class="news-timeline">
					{latestNews.map((entry) => (
						<li class="news-entry">
							<div class="news-marker" aria-hidden="true"></div>
							<div class="news-entry-content">
								<div class="news-date">
									<FormattedDate date={entry.data.date} />
								</div>
								<h3 class="news-title">
								{entry.data.link ? (
									entry.data.link.startsWith('/') ? (
										<a href={entry.data.link}>{entry.data.title}</a>
									) : (
										<a href={entry.data.link} target="_blank" rel="noopener noreferrer">
											{entry.data.title}
										</a>
									)
								) : (
									entry.data.title
								)}
							</h3>
								<p class="news-summary">{entry.data.summary}</p>
								{entry.data.image && <img src={entry.data.image} alt="" class="news-thumb" />}
							</div>
						</li>
					))}

					{latestNews.length === 0 && <p>No news yet.</p>}
				</ol>
				<div style="margin-top: 1.5rem;">
					<a href={url('/news')} style="font-weight: 600;">View All News &rarr;</a>
				</div>
			</section>

			<hr style="margin: 3rem 0; border-top: 1px solid var(--color-border);" />

			<div class="grid-2" style="gap: 4rem; margin-top: 0;">
                <section>
                    <h2 style="margin-top: 0;">Latest Publications</h2>
                    <div class="publication-list">
                        {publications.length > 0 ? publications.map((pub) => (
                            <div class="pub-mini-item">
                                <a class="pub-title" href={`${url('/publications')}#${slugForEntry(pub)}`}>{pub.fields.title.replace(/[{}]/g, '')}</a>
                                <div class="pub-meta">
                                    {pub.authors.map(a => formatAuthor(a)).join(', ')}
                                    <br/>
                                    <span style="font-style: italic; color: var(--color-accent);">
                                        {(pub.fields.journal || pub.fields.booktitle || pub.fields.publisher || pub.fields.howpublished || "Preprint").replace(/[{}]/g, '')}
                                    </span>
                                    {pub.fields.year && <span>, {pub.fields.year}</span>}
                                </div>
                            </div>
                        )) : <p>No publications found.</p>}
                    </div>
                    <div style="margin-top: 1.5rem;">
                        <a href={url('/publications')} style="font-weight: 600;">View Full List &rarr;</a>
                    </div>
                </section>

                <section>
                    <h2 style="margin-top: 0;">Recent Blogposts</h2>
                    <ul style="list-style: none; padding: 0;">
                        {posts.map((post) => (
                            <li class="recent-post-item">
                                <a href={url(`/blog/${post.id}/`)} class="recent-post-thumb" tabindex="-1" aria-hidden="true">
                                    {post.data.heroImage ? (
                                        <Image width={160} height={160} src={post.data.heroImage} alt="" />
                                    ) : (
                                        <img src={url(`/blog/${post.id}.png`)} alt="" />
                                    )}
                                </a>
                                <div class="recent-post-body">
                                    <a href={url(`/blog/${post.id}/`)} class="recent-post-title">
                                        {post.data.title}
                                    </a>
                                    <small style="color: var(--color-text-muted); text-transform: uppercase; font-size: 0.8rem;">
                                        {post.data.pubDate.toLocaleDateString('en-us', {
                                            year: 'numeric',
                                            month: 'short',
                                            day: 'numeric',
                                        })}
                                    </small>
                                </div>
                            </li>
                        ))}
                    </ul>
                    <a href={url('/blog')} style="font-weight: 600;">View Blog &rarr;</a>
                </section>
            </div>
		</main>
		<Footer />
	</body>
</html>
