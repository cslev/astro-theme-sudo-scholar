---
import BaseHead from '../components/BaseHead.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { SITE_TITLE } from '../consts';
import projectsData from '../data/projects.json';
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={`Beyond | ${SITE_TITLE}`} description="Talks, demos, and side projects" />
		<style>
			.projects-section {
				max-width: var(--max-width);
				margin: 0 auto;
			}
			.projects-hero {
				text-align: center;
				margin-bottom: 3rem;
				padding: 2rem 0;
			}
			.projects-hero h1 {
				font-family: var(--font-serif);
				font-size: 3.2rem;
				margin: 0 0 1rem 0;
				color: var(--color-text-main);
				letter-spacing: -0.02em;
				line-height: 1.2;
			}
			.projects-hero p {
				font-size: 1.15rem;
				color: var(--color-text-muted);
				max-width: 700px;
				margin: 0 auto;
				line-height: 1.7;
			}
			.projects-grid {
				display: grid;
				grid-template-columns: repeat(auto-fill, minmax(320px, 1fr));
				gap: 2rem;
				margin-bottom: 4rem;
			}
			.project-card {
				display: flex;
				flex-direction: column;
				background-color: var(--color-bg-offset);
				border: 1px solid var(--color-border-strong);
				border-radius: 16px;
				overflow: hidden;
				transition: box-shadow 0.2s ease, border-color 0.2s ease;
			}
			.project-card:hover {
				box-shadow: var(--shadow-md);
				border-color: var(--color-accent);
			}
			.project-video {
				position: relative;
				width: 100%;
				aspect-ratio: 16 / 9;
				background-color: #000;
			}
			.project-video iframe {
				position: absolute;
				inset: 0;
				width: 100%;
				height: 100%;
				border: 0;
			}
			.project-thumb {
				display: flex;
				align-items: center;
				justify-content: center;
				width: 100%;
				aspect-ratio: 16 / 9;
				/* Fixed white, not a theme variable — one of these two logos
				   (Shudokan) is a transparent PNG whose dark strokes assume a
				   light background; on the dark theme's near-black card that
				   would nearly disappear. */
				background-color: #ffffff;
				padding: 1.25rem;
			}
			.project-thumb img {
				max-width: 100%;
				max-height: 100%;
				object-fit: contain;
			}
			.project-body {
				display: flex;
				flex-direction: column;
				padding: 1.25rem 1.5rem;
				flex: 1;
				gap: 0.75rem;
			}
			.project-card h3 {
				font-family: var(--font-serif);
				font-size: 1.2rem;
				margin: 0;
				line-height: 1.35;
				color: var(--color-text-main);
			}
			.project-tags {
				display: flex;
				flex-wrap: wrap;
				gap: 0.4rem;
			}
			.project-tag {
				display: inline-block;
				padding: 0.15rem 0.6rem;
				border-radius: 999px;
				border: 1px solid var(--color-border-strong);
				background-color: var(--color-bg);
				color: var(--color-text-muted);
				font-size: 0.7rem;
				font-weight: 600;
				text-transform: uppercase;
				letter-spacing: 0.03em;
			}
			.project-link {
				display: inline-flex;
				align-items: center;
				gap: 0.3rem;
				margin-top: auto;
				font-size: 0.9rem;
				color: var(--color-accent);
				text-decoration: none;
				font-weight: 600;
			}
			.project-link:hover {
				text-decoration: underline;
			}
			@media (max-width: 768px) {
				.projects-hero h1 { font-size: 2.5rem; }
				.projects-grid { gap: 1.5rem; }
			}
		</style>
	</head>
	<body>
		<Header />
		<main class="projects-section">
			<div class="projects-hero">
				<h1>Projects</h1>
				<p>A collection of talks, demos, and side projects — some research, some just for fun.</p>
			</div>

			<div class="projects-grid">
				{projectsData.length > 0 ? projectsData.map((project) => (
					<article class="project-card">
						{project.youtubeId ? (
							<div class="project-video">
								<iframe
									src={`https://www.youtube.com/embed/${project.youtubeId}`}
									title={project.title}
									loading="lazy"
									allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture"
									allowfullscreen
								></iframe>
							</div>
						) : project.logo ? (
							<div class="project-thumb">
								<img src={project.logo} alt={project.title} loading="lazy" />
							</div>
						) : null}

						<div class="project-body">
							<h3>{project.title}</h3>

							{project.tags && project.tags.length > 0 && (
								<div class="project-tags">
									{project.tags.map((tag) => (
										<span class="project-tag">{tag}</span>
									))}
								</div>
							)}

							{project.link && (
								<a href={project.link} target="_blank" rel="noopener noreferrer" class="project-link">
									Visit site &rarr;
								</a>
							)}
						</div>
					</article>
				)) : (
					<p>No projects found in <code>src/data/projects.json</code>.</p>
				)}
			</div>
		</main>
		<Footer />
	</body>
</html>
