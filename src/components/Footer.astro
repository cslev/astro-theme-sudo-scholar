---
const today = new Date();
import {
  CONTACT,
  FOOTER_TAGLINE,
  SITE_TITLE,
  SOCIAL_LINKS,
} from '../consts';
import Search from './Search.astro';
import { url } from '../utils/paths';
---

<footer class="site-footer">
    <div class="footer-content">
        <div class="footer-col brand-col">
            <h3>{SITE_TITLE}</h3>
            <p>
                {FOOTER_TAGLINE}
            </p>
            <div class="copyright">
                &copy; {today.getFullYear()} {SITE_TITLE}.<br/>All rights reserved.
            </div>
        </div>

        <div class="footer-col">
            <h4>Quick Links</h4>
            <ul>
                <li><a href={url('/news')}>News</a></li>
                <li><a href={url('/')}>Home</a></li>
                <li><a href={url('/cv')}>CV</a></li>
                <li><a href={url('/blog')}>Blog</a></li>
                <li><a href={url('/publications')}>Publications</a></li>
                <li><a href={url('/projects')}>Projects</a></li>
            </ul>
        </div>

        <div class="footer-col">
            <h4>Contact</h4>
            <p>
                {CONTACT.emails.map((email) => (
                    <>
                        <a href={`mailto:${email}`} style="text-decoration: underline;">{email}</a><br/>
                    </>
                ))}
            </p>
            {CONTACT.emailNote && (
                <p class="email-note">{CONTACT.emailNote}</p>
            )}
        </div>

        <div class="footer-col">
            <h4>Connect</h4>
            <div class="social-links">
                {SOCIAL_LINKS.map((link) => (
                    <a
                        href={link.href}
                        target={link.href.startsWith('mailto:') ? undefined : '_blank'}
                        rel={link.href.startsWith('mailto:') ? undefined : 'noopener noreferrer'}
                        aria-label={link.label}
                    >
                        {link.icon === 'scholar' && (
                            <svg fill="currentColor" viewBox="0 0 32 32" width="24" height="24" xmlns="http://www.w3.org/2000/svg"><path d="M14.573 2.729c-0.729 0.484-4.292 2.849-7.917 5.255s-6.589 4.396-6.589 4.422c0 0.026 0.182 0.146 0.406 0.266 0.224 0.13 3.797 2.109 7.953 4.411l7.542 4.193 0.193-0.099c0.109-0.052 2.891-1.641 6.188-3.521l5.99-3.427 0.036 10.599h3.557v-12.401l-4.615-3.094c-6.219-4.167-11.188-7.448-11.307-7.474-0.063-0.010-0.703 0.38-1.438 0.87zM7.141 22.177l0.016 2.672 8.828 5.292 8.891-5.339v-2.641c0-1.458-0.016-2.646-0.031-2.646-0.021 0-1.76 1.042-3.87 2.323l-4.406 2.661-0.578 0.339-1.755-1.052c-1.464-0.875-2.927-1.755-4.385-2.641l-2.672-1.615c-0.031-0.010-0.042 1.177-0.036 2.646z"></path></svg>
                        )}
                        {link.icon === 'email' && (
                            <svg viewBox="0 0 24 24" width="24" height="24" stroke="currentColor" stroke-width="2" fill="none" stroke-linecap="round" stroke-linejoin="round"><path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"></path><polyline points="22,6 12,13 2,6"></polyline></svg>
                        )}
                        {link.icon === 'website' && (
                            <svg viewBox="0 0 24 24" width="24" height="24" stroke="currentColor" stroke-width="2" fill="none" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"></circle><line x1="2" y1="12" x2="22" y2="12"></line><path d="M12 2a15.3 15.3 0 0 1 4 10 15.3 15.3 0 0 1-4 10 15.3 15.3 0 0 1-4-10 15.3 15.3 0 0 1 4-10z"></path></svg>
                        )}
                        {link.icon === 'github' && (
                            <svg viewBox="0 0 24 24" width="24" height="24" stroke="currentColor" stroke-width="2" fill="none" stroke-linecap="round" stroke-linejoin="round"><path d="M9 19c-5 1.5-5-2.5-7-3m14 6v-3.87a3.37 3.37 0 0 0-.94-2.61c3.14-.35 6.44-1.54 6.44-7A5.44 5.44 0 0 0 20 4.77 5.07 5.07 0 0 0 19.91 1S18.73.65 16 2.48a13.38 13.38 0 0 0-7 0C6.27.65 5.09 1 5.09 1A5.07 5.07 0 0 0 5 4.77a5.44 5.44 0 0 0-1.5 3.78c0 5.42 3.3 6.61 6.44 7A3.37 3.37 0 0 0 9 18.13V22"></path></svg>
                        )}
                        {link.icon === 'linkedin' && (
                            <svg viewBox="0 0 24 24" width="24" height="24" stroke="currentColor" stroke-width="2" fill="none" stroke-linecap="round" stroke-linejoin="round"><path d="M16 8a6 6 0 0 1 6 6v7h-4v-7a2 2 0 0 0-2-2 2 2 0 0 0-2 2v7h-4v-7a6 6 0 0 1 6-6z"></path><rect x="2" y="9" width="4" height="12"></rect><circle cx="4" cy="4" r="2"></circle></svg>
                        )}
                        {link.icon === 'twitter' && (
                            <svg viewBox="0 0 24 24" width="24" height="24" stroke="currentColor" stroke-width="2" fill="none" stroke-linecap="round" stroke-linejoin="round"><path d="M23 3a10.9 10.9 0 0 1-3.14 1.53 4.48 4.48 0 0 0-7.86 3v1A10.66 10.66 0 0 1 3 4s-4 9 5 13a11.64 11.64 0 0 1-7 2c9 5 20 0 20-11.5a4.5 4.5 0 0 0-.08-.83A7.72 7.72 0 0 0 23 3z"></path></svg>
                        )}
                        {link.icon === 'medium' && (
                            <svg viewBox="0 0 24 24" width="24" height="24" stroke="currentColor" stroke-width="2" fill="none" stroke-linecap="round" stroke-linejoin="round"><path d="M12 20h9"></path><path d="M16.5 3.5a2.121 2.121 0 0 1 3 3L7 19l-4 1 1-4Z"></path></svg>
                        )}
                        {link.icon === 'dockerhub' && (
                            <svg viewBox="0 0 24 24" width="24" height="24" stroke="currentColor" stroke-width="2" fill="none" stroke-linecap="round" stroke-linejoin="round"><path d="M21 8a2 2 0 0 0-1-1.73l-7-4a2 2 0 0 0-2 0l-7 4A2 2 0 0 0 3 8v8a2 2 0 0 0 1 1.73l7 4a2 2 0 0 0 2 0l7-4A2 2 0 0 0 21 16Z"></path><path d="m3.3 7 8.7 5 8.7-5"></path><path d="M12 22V12"></path></svg>
                        )}
                        {link.icon === 'matrix' && (
                            <svg fill="currentColor" viewBox="0 0 520 520" width="24" height="24" xmlns="http://www.w3.org/2000/svg"><path d="M13.7,11.9v496.2h35.7V520H0V0h49.4v11.9H13.7z"></path><path d="M166.3,169.2v25.1h0.7c6.7-9.6,14.8-17,24.2-22.2c9.4-5.3,20.3-7.9,32.5-7.9c11.7,0,22.4,2.3,32.1,6.8 c9.7,4.5,17,12.6,22.1,24c5.5-8.1,13-15.3,22.4-21.5c9.4-6.2,20.6-9.3,33.5-9.3c9.8,0,18.9,1.2,27.3,3.6c8.4,2.4,15.5,6.2,21.5,11.5 c6,5.3,10.6,12.1,14,20.6c3.3,8.5,5,18.7,5,30.7v124.1h-50.9V249.6c0-6.2-0.2-12.1-0.7-17.6c-0.5-5.5-1.8-10.3-3.9-14.3 c-2.2-4.1-5.3-7.3-9.5-9.7c-4.2-2.4-9.9-3.6-17-3.6c-7.2,0-13,1.4-17.4,4.1c-4.4,2.8-7.9,6.3-10.4,10.8c-2.5,4.4-4.2,9.4-5,15.1 c-0.8,5.6-1.3,11.3-1.3,17v103.3h-50.9v-104c0-5.5-0.1-10.9-0.4-16.3c-0.2-5.4-1.3-10.3-3.1-14.9c-1.8-4.5-4.8-8.2-9-10.9 c-4.2-2.7-10.3-4.1-18.5-4.1c-2.4,0-5.6,0.5-9.5,1.6c-3.9,1.1-7.8,3.1-11.5,6.1c-3.7,3-6.9,7.3-9.5,12.9c-2.6,5.6-3.9,13-3.9,22.1 v107.6h-50.9V169.2H166.3z"></path><path d="M506.3,508.1V11.9h-35.7V0H520v520h-49.4v-11.9H506.3z"></path></svg>
                        )}
                    </a>
                ))}
            </div>
        </div>
    </div>
</footer>

<Search />

<style>
	.site-footer {
		background-color: var(--color-bg-offset);
		color: var(--color-text-main);
		padding: 4rem 1rem;
        margin-top: auto;
        transition: background-color 0.3s ease;
        position: relative;
	}
    [data-theme='dark'] .site-footer {
        /* --color-bg-offset is the same as the page background in dark
           mode (a deliberate "seamless" choice elsewhere) — the footer
           needs its own brighter shade instead so it reads as a distinct
           section rather than blending invisibly into the page. */
        background-color: #454545;
    }

    .site-footer::before {
        content: "";
        position: absolute;
        top: 0;
        left: 0;
        right: 0;
        height: 1px;
        background: linear-gradient(90deg, transparent 0%, var(--color-border) 20%, var(--color-border) 80%, transparent 100%);
        opacity: 0.6;
    }

    .footer-content {
        max-width: var(--max-width);
        margin: 0 auto;
        display: grid;
        grid-template-columns: 2fr 1fr 1fr 1fr;
        gap: 3rem;
    }
    .footer-col h3 {
        font-family: var(--font-serif);
        font-size: 1.5rem;
        margin-bottom: 1rem;
        color: var(--color-accent);
    }
    .footer-col h4 {
        font-family: var(--font-sans);
        font-size: 0.9rem;
        text-transform: uppercase;
        letter-spacing: 0.05em;
        margin-bottom: 1.25rem;
        color: var(--color-text-main);
    }
    .footer-col ul {
        list-style: none;
        padding: 0;
        margin: 0;
    }
    .footer-col ul li {
        margin-bottom: 0.75rem;
    }
    .footer-col a {
        color: var(--color-text-muted);
        text-decoration: none;
        transition: color 0.2s;
    }
    .footer-col a:hover {
        color: var(--color-accent);
    }
    .brand-col p {
        font-size: 0.95rem;
        line-height: 1.6;
        color: var(--color-text-muted);
        margin-bottom: 1.5rem;
    }
    .copyright {
        font-size: 0.85rem;
        color: var(--color-text-muted);
        line-height: 1.5;
    }
    .email-note {
        margin-top: 0.5rem;
        font-size: 0.8rem;
        line-height: 1.5;
        color: var(--color-text-muted);
        opacity: 0.85;
    }
    .social-links {
        /* 8 icons, laid out as a fixed 2x4 grid rather than letting
           flex-wrap decide the split (which put 5 on one row, 3 on the
           next at this column's width). */
        display: grid;
        grid-template-columns: repeat(4, auto);
        gap: 1rem;
    }
    .social-links a {
        color: var(--color-text-muted);
        transition: all 0.2s;
    }
    .social-links a:hover {
        color: var(--color-accent);
        transform: translateY(-2px);
    }

	@media (max-width: 900px) {
		.footer-content {
            grid-template-columns: 1fr 1fr;
            gap: 2rem;
        }
        .brand-col {
            grid-column: span 2;
        }
	}
    @media (max-width: 600px) {
        .footer-content {
            grid-template-columns: 1fr;
            text-align: center;
        }
        .brand-col {
            grid-column: span 1;
        }
        .social-links {
            justify-content: center;
        }
    }

</style>
