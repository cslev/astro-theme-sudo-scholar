---
import { Image, getImage } from 'astro:assets';
import type { CollectionEntry } from 'astro:content';
import BaseHead from '../components/BaseHead.astro';
import AuthorLink from '../components/AuthorLink.astro';
import Footer from '../components/Footer.astro';
import FormattedDate from '../components/FormattedDate.astro';
import Header from '../components/Header.astro';
import { url } from '../utils/paths';

type Props = CollectionEntry<'datasets'>['data'] & { id?: string };

const { title, description, pubDate, updatedDate, heroImage, authors, tags, datasetUrl, id } = Astro.props;
const fallbackHero = url('/og.png');
// Force the classic 1200x630 og:image ratio for social embeds, regardless
// of the hero photo's own aspect ratio — see BlogPost.astro for why.
const ogImage = heroImage ? await getImage({ src: heroImage, width: 1200, height: 630, format: 'webp' }) : undefined;
---

<html lang="en">
	<head>
		<BaseHead title={title} description={description} image={ogImage?.src} />
		<style>
			html {
				scroll-padding-top: 5.5rem;
			}
			.hero-image {
				position: relative;
				width: 100%;
				aspect-ratio: 2 / 1;
				overflow: hidden;
			}
			.hero-image img {
				display: block;
				width: 100%;
				height: 100%;
				/* Always fill the frame — crop, never letterbox — regardless of
				   the source photo's own aspect ratio. */
				object-fit: cover;
				border-radius: 12px;
				box-shadow: var(--shadow-md);
			}
			.hero-image::after {
				content: '';
				position: absolute;
				inset: 0;
				border-radius: 12px;
				background: rgba(0, 0, 0, 0.62);
				pointer-events: none;
				z-index: 1;
			}
			.hero-caption {
				position: absolute;
				left: 0;
				right: 0;
				bottom: 0;
				z-index: 2;
				padding: 2rem 2.5rem;
				text-align: center;
			}
			.hero-caption .hero-date {
				font-size: 0.9rem;
				text-transform: uppercase;
				letter-spacing: 0.05em;
				color: rgba(255, 255, 255, 0.85);
				margin-bottom: 0.5rem;
			}
			.hero-caption .last-updated-on {
				font-style: italic;
			}
			.hero-caption h1 {
				margin: 0;
				font-size: clamp(1rem, 3.6vw, 2.1rem);
				line-height: 1.3;
				color: #ffffff;
				text-shadow: 0 2px 16px rgba(0, 0, 0, 0.6);
			}
			@media (max-width: 768px) {
				.hero-caption {
					padding: 1.25rem 1.25rem 1.5rem;
				}
			}

			.dataset-container {
				position: relative;
				max-width: 760px;
				margin: 0 auto;
			}
			.prose {
				width: 100%;
				padding: 1rem;
				color: var(--color-text-main);
			}
			.prose :global(p) {
				text-align: justify;
				hyphens: auto;
			}
			.prose :global(img) {
				display: block;
				max-width: 100%;
				height: auto;
				margin: 0 auto;
				border-radius: 12px;
				box-shadow: var(--shadow-sm);
			}

			.title {
				margin-bottom: 1em;
				padding: 1em 0;
				text-align: center;
				line-height: 1.2;
			}
			.dataset-authors {
				display: flex;
				gap: 0.5rem;
				justify-content: center;
				flex-wrap: wrap;
				margin-top: 0.75rem;
				font-size: 0.9rem;
				color: var(--color-text-muted);
			}
			.dataset-tags {
				display: flex;
				gap: 0.5rem;
				justify-content: center;
				flex-wrap: wrap;
				margin-top: 0.75rem;
			}
			.dataset-tag {
				text-decoration: none;
				font-size: 0.85rem;
				font-weight: 600;
				color: var(--color-accent);
				background: var(--color-bg-offset);
				padding: 0.2rem 0.6rem;
				border-radius: 999px;
				border: 1px solid var(--color-border);
			}
			.access-dataset {
				display: flex;
				justify-content: center;
				margin: 1.5rem 0 2rem;
			}
			.access-dataset a {
				display: inline-flex;
				align-items: center;
				gap: 0.5rem;
				padding: 0.75rem 1.5rem;
				border-radius: 999px;
				background: var(--color-accent);
				color: var(--color-bg);
				font-weight: 700;
				font-size: 1rem;
				text-decoration: none;
				box-shadow: var(--shadow-sm);
				transition: transform 0.2s ease, box-shadow 0.2s ease;
			}
			.access-dataset a:hover {
				transform: translateY(-1px);
				box-shadow: var(--shadow-md);
			}
			@media (max-width: 768px) {
				.prose {
					padding: 1rem 0.5rem;
				}
			}
		</style>
	</head>

	<body>
		<Header />
		<main>
			<article>
				<div class="hero-image">
					{heroImage ? (
						<Image width={1020} height={510} src={heroImage} alt={title} />
					) : (
						<img width={1020} height={510} src={fallbackHero} alt={title} />
					)}
					<div class="hero-caption">
						<div class="hero-date">
							<FormattedDate date={pubDate} />
							{
								updatedDate && (
									<span class="last-updated-on">
										· Last updated on <FormattedDate date={updatedDate} />
									</span>
								)
							}
						</div>
						<h1>{title}</h1>
					</div>
				</div>
				<div class="dataset-container">
					<div class="prose">
						<div class="title">
							{authors && authors.length > 0 && (
								<div class="dataset-authors">
									{authors.map((authorId, i) => (
										<span>
											<AuthorLink nameOrSlug={authorId} />
											{i < authors.length - 1 ? ', ' : ''}
										</span>
									))}
								</div>
							)}
							{tags && tags.length > 0 && (
								<div class="dataset-tags">
									{tags.map((tag) => (
										<span class="dataset-tag">#{tag}</span>
									))}
								</div>
							)}
							<hr />
						</div>

						<div class="access-dataset">
							<a href={datasetUrl} target="_blank" rel="noopener noreferrer">Access Dataset &rarr;</a>
						</div>

						<slot />
					</div>
				</div>
			</article>
		</main>
		<Footer />
	</body>
</html>
